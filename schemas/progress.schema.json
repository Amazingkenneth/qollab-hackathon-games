{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Autonomous prototype progress event",
  "type": "object",
  "required": ["timestamp_utc", "run_id", "role", "phase", "event", "status", "summary", "evidence_paths", "next_action"],
  "properties": {
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "run_id": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "phase": {"type": "string", "minLength": 1},
    "event": {"type": "string", "minLength": 1},
    "status": {"enum": ["started", "passed", "failed", "blocked", "fallback"]},
    "summary": {"type": "string", "minLength": 1},
    "evidence_paths": {"type": "array", "items": {"type": "string"}},
    "next_action": {"type": "string"},
    "error_id": {"type": ["string", "null"]},
    "duration_ms": {"type": "number", "minimum": 0},
    "command": {"type": "string"},
    "exit_code": {"type": "integer"},
    "configuration_hash": {"type": "string"}
  },
  "additionalProperties": false
}
